      "Guard": {
        "after": {
          "additionalProperties": false,
          "description": "A durable, machine-evaluable condition that gates a supervision transition.",
          "properties": {
            "applies_to": {
              "description": "Stages whose exit this guard gates.",
              "items": {
                "$ref": "#/$defs/SupervisionStage"
              },
              "type": "array"
            },
            "description": {
              "type": "string"
            },
            "durable": {
              "const": true,
              "description": "Guards are persisted with the work item and re-evaluated on every relevant event, never held only in a prompt."
            },
            "enforcement": {
              "default": "ENFORCED",
              "description": "ENFORCED: a failed guard blocks the transition. ADVISORY: a failed guard is reported in guards_failed and does not block it. Absent means ENFORCED.",
