                  "trust_level"
                ]
              },
              "then": {
                "required": [
                  "principal_statement"
                ]
              }
            }
          ],
          "description": "A time-bounded, scoped grant of authority to one agent. Authority only narrows down the delegation tree.",
          "properties": {
            "constraints": {
              "items": {
                "$ref": "#/$defs/Constraint"
              },
              "type": "array"
            },
            "digest": {
              "description": "Digest of the canonical grant \"<algorithm>:<lowercase hex>\", so approvals and receipts can bind to it.",
              "pattern": "^(sha256|sha384|sha512|blake3):[0-9a-f]{32,128}$",
              "type": "string"
            },
            "expires_at": {
              "format": "date-time",
              "type": "string"
            },
            "grant_id": {
              "description": "Grant identifier.",
              "minLength": 1,
              "type": "string"
            },
            "grantee_agent_id": {
              "description": "Stable agent identifier, e.g. \"agt_impl_7\".",
              "pattern": "^agt_[A-Za-z0-9_.-]+$",
              "type": "string"
            },
            "grantor": {
              "$ref": "#/$defs/PrincipalRef",
              "description": "Who grants the authority (the supervisor agent or a human principal)."
            },
            "parent_grant_id": {
              "description": "The grant this one is derived from. A derived grant's scope MUST be a subset of its parent's, and its expires_at MUST NOT be later.",
              "type": "string"
            },
            "principal_statement": {
              "description": "The principal's words as relayed, recorded verbatim. MUST be present when trust_level is T0_relayed (MAOP section 5.1).",
              "minLength": 1,
              "type": "string"
            },
            "revoked_at": {
              "description": "When the grant was withdrawn; null or absent while it is not revoked. A revoked grant authorizes nothing, nor does any grant derived from it.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "scope": {
              "description": "Capability ids or action scopes the grantee may use, e.g. \"github.pulls.create\".",
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "trust_level": {
              "description": "T0_relayed: the grantee's claims are relayed by the host and treated as assertions. T1_attested: the grantee's receipts are attested (signed or runtime-observed).",
              "enum": [
                "T0_relayed",
                "T1_attested"
              ],
              "type": "string"
            }
          },
          "required": [
            "grant_id",
            "grantee_agent_id",
            "trust_level",
            "scope",
            "expires_at"
