                    "CAOP_422_PRECOMMIT_UNKNOWN_FACT_ID",
                    "STAGE_UPGRADE_RECOMMENDED",
                    "MAOP_403_AUTHORITY_INVALID",
                    "MAOP_403_AUTHORITY_WIDENING",
                    "MAOP_403_TRUST_FLOOR",
                    "MAOP_403_SEPARATION_OF_DUTIES",
                    "MAOP_409_LEASE_CONFLICT",
                    "MAOP_409_LEASE_FENCED",
                    "MAOP_410_LEASE_EXPIRED",
                    "MAOP_409_IDEMPOTENCY_KEY_REUSED",
                    "MAOP_409_OUTCOME_UNRECONCILED",
