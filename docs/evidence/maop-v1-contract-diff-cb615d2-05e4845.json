      "Error": {
        "after": {
          "additionalProperties": false,
          "description": "Standard error envelope (§7.1). v0.1.2 adds CAOP_409_UNSETTLED_EXECUTION_LEASE (HTTP 409), CAOP_413_INVALIDATION_SUBGRAPH_TOO_LARGE (HTTP 413), CAOP_422_VERIFY_ARTIFACT_MISMATCH and the CAOP_422_PRECOMMIT_* codes (HTTP 422; CAOP_422_PRECOMMIT_HOOK_FAILED carries details.failed_hooks), and STAGE_UPGRADE_RECOMMENDED (advisory code, used in resume_brief.system_advisories). MAOP v1 adds the MAOP_* codes of MAOP section 23.2 (HTTP 403, 409, 410 and 422 as the code's number states); MAOP_422_GUARD_FAILED carries details.guards_failed.",
          "properties": {
            "error": {
              "additionalProperties": false,
