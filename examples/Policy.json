{
  "id": "policy_client_email_approval",
  "scope": "capability:email.send",
  "condition": "recipient.type == 'client'",
  "effect": "require_approval",
  "version": "3",
  "enforcement": "enforced",
  "minimum_attestation": "KERNEL_ATTESTED",
  "pre_commit_hooks": [
    {
      "hook_id": "REQUIRE_EXPLICIT_OWNER",
      "target_path": "commitment.owner_principal_id",
      "condition": "NON_EMPTY_PRINCIPAL_REF",
      "error_code": "CAOP_422_PRECOMMIT_MISSING_OWNER"
    }
  ]
}
